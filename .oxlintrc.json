{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "eslint",
    "oxc"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "warn"
  },
  "rules": {
    "eslint/complexity": [
      "error",
      8
    ],
    "eslint/one-var": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-vars": "off",
    "@typescript-eslint/strict-boolean-expressions": "off",
    "@typescript-eslint/prefer-readonly-parameter-types": "warn"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "server/listener.ts",
        "server/errors.ts",
        "**/*controller.ts"
      ],
      "rules": {
        "@typescript-eslint/prefer-readonly-parameter-types": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}