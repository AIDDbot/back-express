{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "eslint", "oxc", "import"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "off"
  },
  "rules": {
    "eslint/one-var": ["error", "never"],
    "eslint/sort-imports": "off",
    "eslint/sort-vars": "off",
    "@typescript-eslint/strict-boolean-expressions": "off",
    "@typescript-eslint/prefer-readonly-parameter-types": "off",
    "import/no-cycle": "error",
    "import/no-self-import": "error"
  },
  "overrides": [
    {
      "files": ["src/main.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    },
    {
      "files": ["src/shared/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**", "express", "cors"],
                "message": "shared/ is the leaf layer: only Node built-ins and other shared/ files, no Express."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/core/**/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../api/**", "../main.js"],
                "message": "core/ is infrastructure: it may use shared/, never api/ features or main."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "./*/*.service.js",
                  "./*/*.repository.js",
                  "../core/**",
                  "../shared/db.js",
                  "../main.js"
                ],
                "message": "The router only wires controllers and middleware."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/*/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../*/*",
                  "!../*/*.middleware.js",
                  "!../*/*.types.js",
                  "../api.js",
                  "../../main.js"
                ],
                "message": "A feature reaches another one only through its *.middleware.js or *.types.js, and never imports the router or main."
              },
              {
                "group": ["../../core/**", "../../shared/db.js"],
                "message": "Features never use core/, and only repositories open the database (shared/db.js)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/*/*.controller.ts", "src/api/*/*.middleware.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../*/*",
                  "!../*/*.middleware.js",
                  "!../*/*.types.js",
                  "../api.js",
                  "../../main.js"
                ],
                "message": "A feature reaches another one only through its *.middleware.js or *.types.js, and never imports the router or main."
              },
              {
                "group": ["../../core/**", "../../shared/db.js"],
                "message": "Features never use core/, and only repositories open the database (shared/db.js)."
              },
              {
                "group": ["./*.controller.js", "./*.repository.js"],
                "message": "HTTP handlers reach data through services and never import controllers or repositories."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/*/*.service.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../*/*",
                  "!../*/*.service.js",
                  "!../*/*.types.js",
                  "../api.js",
                  "../../main.js"
                ],
                "message": "A service reaches another feature only through its *.service.js or *.types.js, and never imports the router or main."
              },
              {
                "group": ["../../core/**", "../../shared/db.js"],
                "message": "Features never use core/, and only repositories open the database (shared/db.js)."
              },
              {
                "group": ["express", "./*.controller.js", "./*.middleware.js"],
                "message": "Services hold business logic: no Express or HTTP layer, and data only through their repository."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/*/*.repository.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../*/*", "!../*/*.types.js", "../api.js", "../../main.js"],
                "message": "A repository owns only its feature's tables; other features are reached through their service."
              },
              {
                "group": [
                  "express",
                  "../../core/**",
                  "../../shared/errors.js",
                  "./*.controller.js",
                  "./*.middleware.js",
                  "./*.service.js"
                ],
                "message": "Repositories only talk to the database (shared/db.js): no HTTP errors, Express, core/ or upper layers. Throw a domain error and let the service map it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/api/*/*.types.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "express",
                  "./*",
                  "!./*.types.js",
                  "../*/*",
                  "!../*/*.types.js",
                  "../api.js",
                  "../../**",
                  "!../../shared/**",
                  "../../shared/db.js"
                ],
                "message": "Type files are leaves: only other *.types.js and shared/ (never the database)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "rules": {
        "@typescript-eslint/prefer-readonly-parameter-types": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-assignment": "off",
        "unicorn/no-useless-undefined": "off",
        "oxc/approx-constant": "off",
        "eslint/no-restricted-imports": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
