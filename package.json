{
  "name": "back-express",
  "version": "0.2.0",
  "description": "Back-end Express archetype",
  "keywords": [
    "archetype",
    "backend",
    "express",
    "node",
    "starter"
  ],
  "homepage": "https://aiddbot.com",
  "license": "MIT",
  "author": {
    "name": "Alberto Basalo",
    "email": "albertobasalo@aicode.academy",
    "url": "https://aicode.academy"
  },
  "repository": {
    "url": "https://github.com/AIDDbot/back-express"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "test": "node --import ./test.setup.ts --test \"src/**/*.test.ts\"",
    "test:watch": "node --watch --import ./test.setup.ts --test \"src/**/*.test.ts\"",
    "lint": "oxlint --format=agent --quiet",
    "lint:fix": "oxlint --fix --format=agent --quiet",
    "format": "oxfmt --write",
    "fix": "node --run lint:fix && node --run format",
    "quality:warnings": "oxlint --deny-warnings --format=agent",
    "quality:complexity": "oxlint -c .oxlintrc.complexity.json --format=agent --quiet",
    "quality:coverage": "node --experimental-config-file=coverage.config.json \"src/**/*.test.ts\"",
    "quality:all": "node --run quality:warnings && node --run quality:complexity && node --run quality:coverage"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2"
  },
  "config": {
    "codename": "oktoberfest"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "packageManager": "npm@11.19.1"
}
